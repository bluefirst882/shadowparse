      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "workbench-prometheus" },
          "expr": "sum(rate(workbench_transcription_duration_seconds_sum[1h])) / clamp_min(sum(rate(workbench_transcription_duration_seconds_count[1h])), 1)",
          "legendFormat": "平均"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "workbench-prometheus" },
          "expr": "max(workbench_transcription_duration_seconds_max)",
          "legendFormat": "最大"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "队列等待时长（平均 / P95）",
      "datasource": { "type": "prometheus", "uid": "workbench-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
