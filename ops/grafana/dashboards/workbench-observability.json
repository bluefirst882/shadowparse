    {
      "id": 7,
      "type": "timeseries",
      "title": "LLM Token 用量（累计）",
      "datasource": { "type": "prometheus", "uid": "workbench-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto",
            "lineInterpolation": "smooth"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "workbench-prometheus" },
          "expr": "sum by (type) (workbench_llm_tokens_total)",
          "legendFormat": "{{type}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "LLM 调用次数（累计，按操作与结果）",
      "datasource": { "type": "prometheus", "uid": "workbench-prometheus" },
