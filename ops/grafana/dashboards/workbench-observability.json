        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "workbench-prometheus" },
          "expr": "sum(workbench_transcription_duration_seconds_sum) / clamp_min(sum(workbench_transcription_duration_seconds_count), 1)",
          "legendFormat": "avg"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "当前队列深度",
