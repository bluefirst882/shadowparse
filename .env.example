# 仅发送转写文本；未设置密钥时，本地转写仍可完成。
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_HOST_PORT=3307
BACKEND_HOST_PORT=8081
FRONTEND_HOST_PORT=5174
MYSQL_DATABASE=video_workbench
MYSQL_USER=video_workbench
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=20GB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=20GB
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_REASONING_EFFORT=low
# 模型单价（每百万 token），只用于把 usage 折算成单视频成本，格式「模型:输入单价:输出单价」。
# 仓库不内置任何价格，请按你账号的实际计费单价填写；留空则只统计 token，导出成本为 null。
# 示例：LLM_PRICES=deepseek-v4-flash:0.28:0.42,deepseek-v4-pro:1.1:2.2
LLM_PRICES=
LLM_PRICE_CURRENCY=USD
# 下游容错（Resilience4j）：超时由 HTTP 客户端强制；并发隔板超出上限的调用直接拒绝、不排队。
WORKBENCH_LLM_TIMEOUT_SECONDS=90
WORKBENCH_LLM_TRANSLATE_TIMEOUT_SECONDS=180
WORKBENCH_LLM_MAX_CONCURRENT=4
WORKBENCH_WHISPER_MAX_CONCURRENT=1
FFMPEG_PATH=ffmpeg
WHISPER_MODEL=turbo
WHISPER_SERVICE_URL=http://host.docker.internal:8090
WHISPER_SERVICE_TOKEN=replace-with-a-random-secret-at-least-32-characters
WHISPER_MODEL_DIR=E:/model/whisper
WHISPER_VENV=E:/model/toni-whisper-venv
WORKBENCH_PROCESS_TIMEOUT_MINUTES=180
# 任务队列（RabbitMQ）：任务是先落库为 QUEUED 再投递消息，队列与消息都持久化，进程重启不丢任务。
RABBITMQ_PORT=5672
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672
RABBITMQ_USERNAME=workbench
RABBITMQ_PASSWORD=
# JWT 签名密钥，至少 32 字符，请自行生成随机值；同时控制令牌有效期（小时）。
WORKBENCH_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
WORKBENCH_TOKEN_TTL_HOURS=24
# 可观测性栈：Prometheus 抓取 backend:8080/actuator/prometheus，Grafana 自动加载预置面板。
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=workbench
