  "source": "MySQL video_workbench.transcript_segments where task_id = 6493bbed-aa77-4707-abec-41a5e03f292d order by start_ms, id",
  "segments": [
    {
      "id": 3948,
      "text": "转大四学生",
      "endMs": 900,
      "startMs": 0,
      "translation": null
    },
    {
      "id": 3949,
      "text": "暑假在家从零开始做AI开发",
      "endMs": 2560,
      "startMs": 900,
      "translation": null
    },
    {
      "id": 3950,
      "text": "接项目之后",
      "endMs": 3340,
      "startMs": 2560,
      "translation": null
    },
    {
      "id": 3951,
      "text": "月收入做到了4000家",
      "endMs": 4460,
      "startMs": 3340,
      "translation": null
    },
    {
      "id": 3952,
      "text": "今天想把我这段时间积累的一些经验",
      "endMs": 6320,
      "startMs": 4460,
      "translation": null
    },
    {
      "id": 3953,
      "text": "以及踩过的坑",
      "endMs": 7100,
      "startMs": 6320,
      "translation": null
    },
    {
      "id": 3954,
      "text": "分享给大家",
      "endMs": 7940,
      "startMs": 7100,
      "translation": null
    },
    {
      "id": 3955,
      "text": "我觉得",
      "endMs": 8360,
      "startMs": 7940,
      "translation": null
    },
    {
      "id": 3956,
      "text": "AI开发最重要的",
      "endMs": 9480,
      "startMs": 8360,
      "translation": null
    },
    {
      "id": 3957,
      "text": "是你能不能把一个项目拆清楚",
      "endMs": 11000,
      "startMs": 9480,
      "translation": null
    },
    {
      "id": 3958,
      "text": "管明白",
      "endMs": 11500,
      "startMs": 11000,
      "translation": null
    },
    {
      "id": 3959,
      "text": "我接到项目之后",
      "endMs": 12520,
      "startMs": 11500,
      "translation": null
    },
    {
      "id": 3960,
      "text": "第一步不是马上打开AI",
      "endMs": 13840,
      "startMs": 12520,
      "translation": null
    },
    {
      "id": 3961,
      "text": "让它开始写代码",
      "endMs": 14860,
      "startMs": 13840,
      "translation": null
    },
    {
      "id": 3962,
      "text": "而是先和客户沟通",
      "endMs": 15920,
      "startMs": 14860,
      "translation": null
    },
    {
      "id": 3963,
      "text": "确认客户到底要解决什么问题",
      "endMs": 17520,
      "startMs": 15920,
      "translation": null
    },
    {
      "id": 3964,
      "text": "有哪些具体功能",
      "endMs": 18560,
      "startMs": 17520,
      "translation": null
    },
    {
      "id": 3965,
      "text": "最终要交付什么结果",
      "endMs": 19800,
      "startMs": 18560,
      "translation": null
    },
    {
      "id": 3966,
      "text": "需求确认之后",
      "endMs": 20720,
      "startMs": 19800,
      "translation": null
    },
    {
      "id": 3967,
      "text": "我会先整理成一份完整的项目文档",
      "endMs": 22520,
      "startMs": 20720,
      "translation": null
    },
    {
      "id": 3968,
      "text": "把功能范围",
      "endMs": 23260,
      "startMs": 22520,
      "translation": null
    },
    {
      "id": 3969,
      "text": "使用流程",
      "endMs": 23920,
      "startMs": 23260,
      "translation": null
    },
    {
      "id": 3970,
      "text": "数据结构",
      "endMs": 24560,
      "startMs": 23920,
      "translation": null
    },
    {
      "id": 3971,
      "text": "验收标准",
      "endMs": 25320,
      "startMs": 24560,
      "translation": null
    },
    {
      "id": 3972,
      "text": "以及哪些内容暂时不做",
      "endMs": 26640,
      "startMs": 25320,
      "translation": null
    },
    {
      "id": 3973,
      "text": "都写清楚",
      "endMs": 27340,
      "startMs": 26640,
      "translation": null
    },
    {
      "id": 3974,
      "text": "这一步非常重要",
      "endMs": 28360,
      "startMs": 27340,
      "translation": null
    },
    {
      "id": 3975,
      "text": "因为很多项目最后做失败",
      "endMs": 29720,
      "startMs": 28360,
      "translation": null
    },
    {
      "id": 3976,
      "text": "不是代码写不出来",
      "endMs": 30760,
      "startMs": 29720,
      "translation": null
    },
    {
      "id": 3977,
      "text": "而是一开始双方对需求的理解就不一致",
      "endMs": 32720,
      "startMs": 30760,
      "translation": null
    },
    {
      "id": 3978,
      "text": "做到一半",
      "endMs": 33340,
      "startMs": 32720,
      "translation": null
    },
    {
      "id": 3979,
      "text": "客户不断增加需求",
      "endMs": 34500,
      "startMs": 33340,
      "translation": null
    },
    {
      "id": 3980,
      "text": "AI也会跟着不断改方向",
      "endMs": 35920,
      "startMs": 34500,
      "translation": null
    },
    {
      "id": 3981,
      "text": "最后项目很容易失控",
      "endMs": 37080,
      "startMs": 35920,
      "translation": null
    },
    {
      "id": 3982,
      "text": "所以在需求确认之后",
      "endMs": 38300,
      "startMs": 37080,
      "translation": null
    },
    {
      "id": 3983,
      "text": "我会让AI整理到Obsidian里面",
      "endMs": 39960,
      "startMs": 38300,
      "translation": null
    },
    {
      "id": 3984,
      "text": "我在Obsidian里主要维护三类东西",
      "endMs": 41800,
      "startMs": 39960,
      "translation": null
    },
    {
      "id": 3985,
      "text": "第一类是项目架构",
      "endMs": 42880,
      "startMs": 41800,
      "translation": null
    },
    {
      "id": 3986,
      "text": "明确整个系统有哪些模块",
      "endMs": 44300,
      "startMs": 42880,
      "translation": null
    },
    {
      "id": 3987,
      "text": "每个模块负责什么",
      "endMs": 45340,
      "startMs": 44300,
      "translation": null
    },
    {
      "id": 3988,
      "text": "第二类是模块文档",
      "endMs": 46420,
      "startMs": 45340,
      "translation": null
    },
    {
      "id": 3989,
      "text": "拆成一个个可以独立完成的小步骤",
      "endMs": 55400,
      "startMs": 53920,
      "translation": null
    },
    {
      "id": 3990,
      "text": "而不是笼统地告诉AI",
      "endMs": 56580,
      "startMs": 55400,
      "translation": null
    },
    {
      "id": 3991,
      "text": "帮我做一个某某功能",
      "endMs": 57740,
      "startMs": 56580,
      "translation": null
    },
    {
      "id": 3992,
      "text": "而是拆成",
      "endMs": 58460,
      "startMs": 57740,
      "translation": null
    },
    {
      "id": 3993,
      "text": "每完成一个步骤",
      "endMs": 59400,
      "startMs": 58460,
      "translation": null
    },
    {
      "id": 3994,
      "text": "我就更新一次任务状态",
      "endMs": 60720,
      "startMs": 59400,
      "translation": null
    },
    {
      "id": 3995,
      "text": "并运行对应的测试",
      "endMs": 61700,
      "startMs": 60720,
      "translation": null
    },
    {
      "id": 3996,
      "text": "我给AI的提示词",
      "endMs": 62740,
      "startMs": 61700,
      "translation": null
    },
    {
      "id": 3997,
      "text": "也是提前整理成固定的任务模板",
      "endMs": 64420,
      "startMs": 62740,
      "translation": null
    },
    {
      "id": 3998,
      "text": "每次开启新对话时",
      "endMs": 65560,
      "startMs": 64420,
      "translation": null
    },
    {
      "id": 3999,
      "text": "只把当前任务相关的架构",
      "endMs": 66980,
      "startMs": 65560,
      "translation": null
    },
    {
      "id": 4000,
      "text": "模块文档和验收标准交给它",
      "endMs": 68580,
      "startMs": 66980,
      "translation": null
    },
    {
      "id": 4001,
      "text": "让AI只读取需要的内容",
      "endMs": 70160,
      "startMs": 68580,
      "translation": null
    },
    {
      "id": 4002,
      "text": "这样做有两个好处",
      "endMs": 71040,
      "startMs": 70160,
      "translation": null
    },
    {
      "id": 4003,
      "text": "第一",
      "endMs": 71420,
      "startMs": 71040,
      "translation": null
    },
    {
      "id": 4004,
      "text": "可以减小上下文污染",
      "endMs": 72640,
      "startMs": 71420,
      "translation": null
    },
    {
      "id": 4005,
      "text": "AI不需要每次重新理解整个项目",
      "endMs": 74440,
      "startMs": 72640,
      "translation": null
    },
    {
      "id": 4006,
      "text": "也不会因为读了太多无关内容而跑偏",
      "endMs": 76260,
      "startMs": 74440,
      "translation": null
    },
    {
      "id": 4007,
      "text": "第二",
      "endMs": 76640,
      "startMs": 76260,
      "translation": null
    },
    {
      "id": 4008,
      "text": "可以让AI知道",
      "endMs": 77520,
      "startMs": 76640,
      "translation": null
    },
    {
      "id": 4009,
      "text": "出现bug时应该去哪里找",
      "endMs": 78860,
      "startMs": 77520,
      "translation": null
    },
    {
      "id": 4010,
      "text": "而不是让AI在整个项目里盲目修改",
      "endMs": 80680,
      "startMs": 78860,
      "translation": null
    },
    {
      "id": 4011,
      "text": "开发过程中",
      "endMs": 81480,
      "startMs": 80680,
      "translation": null
    },
    {
      "id": 4012,
      "text": "我还会坚持一个原则",
      "endMs": 82640,
      "startMs": 81480,
      "translation": null
    },
    {
      "id": 4013,
      "text": "先写测试",
      "endMs": 83360,
      "startMs": 82640,
      "translation": null
    },
    {
      "id": 4014,
      "text": "再写实现",
      "endMs": 84060,
      "startMs": 83360,
      "translation": null
    },
    {
      "id": 4015,
      "text": "先让测试准确描述我想要的行为",
      "endMs": 85800,
      "startMs": 84060,
      "translation": null
    },
    {
      "id": 4016,
      "text": "确认测试失败之后",
      "endMs": 86900,
      "startMs": 85800,
      "translation": null
    },
    {
      "id": 4017,
      "text": "再让AI完成功能",
      "endMs": 88000,
      "startMs": 86900,
      "translation": null
    },
    {
      "id": 4018,
      "text": "最后把相关测试跑到通过",
      "endMs": 89420,
      "startMs": 88000,
      "translation": null
    },
    {
      "id": 4019,
      "text": "这样AI写出来的代码",
      "endMs": 90740,
      "startMs": 89420,
      "translation": null
    },
    {
      "id": 4020,
      "text": "就不是看起来能用",
      "endMs": 91780,
      "startMs": 90740,
      "translation": null
    },
    {
      "id": 4021,
      "text": "而是有明确验收标准的",
      "endMs": 93080,
      "startMs": 91780,
      "translation": null
    },
    {
      "id": 4022,
      "text": "还有一个很重要的经验",
      "endMs": 94220,
      "startMs": 93080,
      "translation": null
    },
    {
      "id": 4023,
      "text": "就是不要让一轮对话承载太多事情",
      "endMs": 96060,
      "startMs": 94220,
      "translation": null
    },
    {
      "id": 4024,
      "text": "根据我的使用体验",
      "endMs": 97120,
      "startMs": 96060,
      "translation": null
    },
    {
      "id": 4025,
      "text": "Codex在向下文压缩之后",
      "endMs": 98560,
      "startMs": 97120,
      "translation": null
    },
    {
      "id": 4026,
      "text": "后续成本和稳定性都会受到影响",
      "endMs": 100320,
      "startMs": 98560,
      "translation": null
    },
    {
      "id": 4027,
      "text": "所以我会开多个窗口",
      "endMs": 101580,
      "startMs": 100320,
      "translation": null
    },
    {
      "id": 4028,
      "text": "这样做不仅可以节省token",
      "endMs": 102920,
      "startMs": 101580,
      "translation": null
    },
    {
      "id": 4029,
      "text": "也能减少AI的记忆串现",
      "endMs": 104300,
      "startMs": 102920,
      "translation": null
    },
    {
      "id": 4030,
      "text": "它不会因为修改性功能",
      "endMs": 105620,
      "startMs": 104300,
      "translation": null
    },
    {
      "id": 4031,
      "text": "又把之前已经完成的功能改坏",
      "endMs": 107140,
      "startMs": 105620,
      "translation": null
    },
    {
      "id": 4032,
      "text": "当然",
      "endMs": 107500,
      "startMs": 107140,
      "translation": null
    },
    {
      "id": 4033,
      "text": "多窗口并不代表可以随便拆",
      "endMs": 109080,
      "startMs": 107500,
      "translation": null
    },
    {
      "id": 4034,
      "text": "前提是你必须提前把项目架构",
      "endMs": 110720,
      "startMs": 109080,
      "translation": null
    },
    {
      "id": 4035,
      "text": "模块边界和任务依赖关系设计好",
      "endMs": 112440,
      "startMs": 110720,
      "translation": null
    },
    {
      "id": 4036,
      "text": "否则窗口越多",
      "endMs": 113360,
      "startMs": 112440,
      "translation": null
    },
    {
      "id": 4037,
      "text": "反而越容易混乱",
      "endMs": 114220,
      "startMs": 113360,
      "translation": null
    },
    {
      "id": 4038,
      "text": "这套方法不一定适合所有人",
      "endMs": 115800,
      "startMs": 114220,
      "translation": null
    },
    {
      "id": 4039,
      "text": "但对我来说",
      "endMs": 116540,
      "startMs": 115800,
      "translation": null
    },
    {
      "id": 4040,
      "text": "它解决了一个非常现实的问题",
      "endMs": 118040,
      "startMs": 116540,
      "translation": null
    },
    {
      "id": 4041,
      "text": "我不需要一次性记住整个项目",
      "endMs": 119600,
      "startMs": 118040,
      "translation": null
    },
    {
      "id": 4042,
      "text": "也不需要让AI一次性完成整个项目",
      "endMs": 121440,
      "startMs": 119600,
      "translation": null
    },
    {
      "id": 4043,
      "text": "我只需要把项目拆小",
      "endMs": 122640,
      "startMs": 121440,
      "translation": null
    },
    {
      "id": 4044,
      "text": "把每一步写清楚",
      "endMs": 123580,
      "startMs": 122640,
      "translation": null
    },
    {
      "id": 4045,
      "text": "再让AI在明确的边界内持续推进",
      "endMs": 125500,
      "startMs": 123580,
      "translation": null
    },
    {
      "id": 4046,
      "text": "总结一下",
      "endMs": 126180,
      "startMs": 125500,
      "translation": null
    },
    {
      "id": 4047,
      "text": "AI是一个执行能力很强的开发助手",
      "endMs": 128040,
      "startMs": 126180,
      "translation": null
    },
    {
      "id": 4048,
      "text": "而Obsidian",
      "endMs": 128620,
      "startMs": 128040,
      "translation": null
    },
    {
      "id": 4049,
      "text": "就像是项目的大脑和导航地图",
      "endMs": 130360,
      "startMs": 128620,
      "translation": null
    },
    {
      "id": 4050,
      "text": "二者的结合",
      "endMs": 130960,
      "startMs": 130360,
      "translation": null
    },
    {
      "id": 4051,
      "text": "可以让我们快速地实现复杂的项目",
      "endMs": 132780,
      "startMs": 130960,
      "translation": null
    },
    {
      "id": 4052,
      "text": "希望我的经验能够帮到大家",
      "endMs": 134040,
      "startMs": 132780,
      "translation": null
    }
  ],
